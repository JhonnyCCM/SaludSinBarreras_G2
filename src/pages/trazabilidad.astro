---

<BaseLayout title="Trazabilidad F1–F4" description="Relación entre requisitos de los formatos F1 a F4 y las pantallas del prototipo.">
  <section class="card mb-3">
    <h1>Trazabilidad F1–F4</h1>
    <p>Dónde se implementa cada requisito de los formatos del Grupo 5.</p>
    <ul>
      <li><a href="#rf">Requisitos funcionales (F1 y F2)</a></li>
      <li><a href="#f3">Menú de accesibilidad (F3)</a></li>
      <li><a href="#f4">Criterios de formularios (F4)</a></li>
    </ul>
  </section>

  <section class="card mb-3" id="rf" aria-labelledby="t-rf">
    <h2 id="t-rf">Requisitos funcionales (F2)</h2>
    <div class="table-scroll">
      <table class="data-table">
        <caption class="sr-only">Requisitos funcionales y pantalla donde se implementan</caption>
        <thead><tr><th scope="col">Código</th><th scope="col">Usuario</th><th scope="col">Tarea</th><th scope="col">Qué hace</th><th scope="col">Pantalla</th></tr></thead>
        <tbody>
          {RF.map(([c, u, t, d, href]) => (
            <tr><th scope="row">{c}</th><td>{u}</td><td>{t}</td><td>{d}</td><td><a href={href}>{href}</a></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="card mb-3" id="f3" aria-labelledby="t-f3">
    <h2 id="t-f3">Menú de accesibilidad (F3)</h2>
    <p class="form-hint">Todas están en ♿ Menú de accesibilidad (<kbd>Alt+Shift+A</kbd>).</p>
    <div class="table-scroll">
      <table class="data-table">
        <caption class="sr-only">Opciones del menú y criterio WCAG</caption>
        <thead><tr><th scope="col">Categoría</th><th scope="col">Opción</th><th scope="col">WCAG 2.2</th></tr></thead>
        <tbody>{F3.map(([c, o, w]) => <tr><td>{c}</td><td>{o}</td><td>{w}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="card" id="f4" aria-labelledby="t-f4">
    <h2 id="t-f4">Criterios de formularios (F4)</h2>
    <div class="table-scroll">
      <table class="data-table">
        <caption class="sr-only">Criterios WCAG aplicados a los formularios</caption>
        <thead><tr><th scope="col">Principio</th><th scope="col">Criterios</th><th scope="col">Cómo se aplica</th></tr></thead>
        <tbody>{F4.map(([p, c, h]) => <tr><td>{p}</td><td>{c}</td><td>{h}</td></tr>)}</tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .table-scroll { overflow-x: auto; }
</style>
