---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Inicio" description="SaludSinBarreras: telemedicina accesible para pacientes con discapacidad, profesionales de salud e intérpretes de señas.">
  <section class="hero card mb-3">
    <div>
      <h1>Telemedicina sin barreras de comunicación</h1>
      <p>
        Consultas médicas por video para personas con discapacidad visual, auditiva, motriz, cognitiva o del habla,
        con subtítulos, intérprete de Lengua de Señas Ecuatoriana, lectura en voz alta y lectura fácil.
      </p>
      <div class="flex-wrap">
        <a href="/paciente/registro" class="btn btn-primary">📝 Registrarme como paciente</a>
        <a href="/login" class="btn btn-secondary">🔑 Iniciar sesión</a>
      </div>
    </div>
    <p id="agent-status" class="agent-status" role="status">Comprobando el agente de IA…</p>
  </section>

  <section class="mb-3" aria-labelledby="t-roles">
    <h2 id="t-roles">¿Quién eres?</h2>
    <div class="grid-auto">
      <article class="card role-card">
        <span class="role-icon" aria-hidden="true">🩺</span>
        <h3>Profesional de salud</h3>
        <p>Organiza tu agenda, prepara cada consulta según los apoyos del paciente, firma el resumen de la IA, emite recetas y registra la atención.</p>
        <button type="button" class="btn btn-primary" data-demo="profesional:prof-001">Entrar como Dra. Valeria Viteri</button>
      </article>
      <article class="card role-card">
        <span class="role-icon" aria-hidden="true">🧑</span>
        <h3>Paciente</h3>
        <p>Reserva citas, plantea tus preguntas en tu modalidad, recibe indicaciones claras y recordatorios por el canal que prefieras.</p>
        <button type="button" class="btn btn-primary" data-demo="paciente:pac-001">Entrar como María (auditiva)</button>
      </article>
      <article class="card role-card">
        <span class="role-icon" aria-hidden="true">🤟</span>
        <h3>Intérprete de señas</h3>
        <p>Recibe solicitudes, prepárate con el contexto mínimo y un glosario, e interpreta con tu video fijo en la pantalla del paciente.</p>
        <button type="button" class="btn btn-primary" data-demo="interprete:int-001">Entrar como Lic. Gabriela Intriago</button>
      </article>
    </div>
  </section>

  <section class="card mb-3" aria-labelledby="t-sim">
    <h2 id="t-sim">Prueba los apoyos de cada paciente</h2>
    <p class="form-hint">Aplica en un clic las opciones del menú que se activan según su discapacidad (tabla del F4).</p>
    <div id="sim-profiles" class="grid-auto mt-2"></div>
  </section>

  <section class="grid-auto" aria-label="Cómo está construido">
    <article class="card">
      <h3>♿ Menú de accesibilidad (F3)</h3>
      <p>15 opciones por categoría: tamaño de texto, contraste, interlineado, espaciado, subtítulos, ventana del intérprete, atajos Alt+Shift y más.</p>
    </article>
    <article class="card">
      <h3>📝 Formularios accesibles (F4)</h3>
      <p>Errores explicados junto al campo, revisión antes de enviar, aviso de tiempo de sesión, borradores automáticos e inicio de sesión sin captcha.</p>
    </article>
    <article class="card">
      <h3>🦀 Agente IA en Rust</h3>
      <p>No conversa: ordena preguntas, resume indicaciones para firmar y convierte lo que se dice en glosas de señas y texto para lector de pantalla en tiempo real.</p>
    </article>
  </section>
</BaseLayout>

<style is:global>
  .hero { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .hero > div { max-width: 70ch; }
  .agent-status { padding: 0.5rem 0.9rem; border-radius: var(--radius); border: 2px solid var(--border-subtle); font-weight: 700; margin: 0; }
  .role-card { display: flex; flex-direction: column; gap: 0.5rem; }
  .role-card p { flex: 1; }
  .role-icon { font-size: 2.4rem; }
</style>

<script>
  import { applyAccessibilityState, loadAccessibilityState, triggerVisualAlert } from '../lib/accessibility';
  import { agentBaseUrl } from '../lib/ai-harness/providers';
  import { esc } from '../lib/forms';
  import { ROLE_HOME, demoAccounts, startSession, type Role } from '../lib/session';
  import { DISABILITY_LABELS, getPatient, getPatients } from '../lib/store';
  import { SUPPORTS, a11yPatchFromSupports } from '../lib/supports';

  document.querySelectorAll<HTMLButtonElement>('[data-demo]').forEach((b) =>
    b.addEventListener('click', () => {
      const [role, userId] = b.dataset.demo!.split(':') as [Role, string];
      const acc = demoAccounts().find((a) => a.role === role && a.userId === userId);
      if (!acc) return;
      startSession(acc);
      location.href = ROLE_HOME[role];
    })
  );

  const status = document.getElementById('agent-status')!;
  fetch(`${agentBaseUrl()}/salud`, { signal: AbortSignal.timeout(1500) })
    .then((r) => r.json())
    .then((j: { version?: string }) => {
      status.textContent = `🦀 Agente Rust conectado (v${j.version ?? '?'}): señas y lector en tiempo real`;
      status.style.borderColor = 'var(--success-border)';
    })
    .catch(() => {
      status.textContent = '💻 Agente Rust apagado: se usa el motor local (npm run agente para encenderlo)';
      status.style.borderColor = 'var(--warning-border)';
    });

  document.getElementById('sim-profiles')!.innerHTML = getPatients()
    .map((p) => {
      const full = getPatient(p.id)!;
      return `<article class="card" style="background: var(--bg);">
        <strong>${esc(p.fullName)}</strong>
        <p class="form-hint">${esc(p.disabilities.map((d) => DISABILITY_LABELS[d]).join(', '))}</p>
        <p style="margin: 0 0 0.5rem;">${esc(full.supports.map((k) => SUPPORTS[k].label).join(' · '))}</p>
        <button type="button" class="btn btn-secondary" data-sim="${p.id}">♿ Aplicar sus apoyos</button>
      </article>`;
    })
    .join('');
  document.querySelectorAll<HTMLButtonElement>('[data-sim]').forEach((b) =>
    b.addEventListener('click', () => {
      const p = getPatient(b.dataset.sim!)!;
      applyAccessibilityState({ ...loadAccessibilityState(), ...a11yPatchFromSupports(p.supports) });
      triggerVisualAlert(`Apoyos de ${p.fullName} aplicados. Restablécelos desde el menú de accesibilidad.`);
    })
  );
</script>
