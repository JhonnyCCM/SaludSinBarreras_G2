---
import AccessibilityMenu from '../components/AccessibilityMenu.astro';
import SessionTimeout from '../components/SessionTimeout.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Plataforma de telemedicina accesible con enfoque WCAG 2.2 y Harness de IA No Conversacional.',
} = Astro.props;

const pathname = Astro.url.pathname;
const isCurrent = (target: string) =>
  pathname === target || (target !== '/' && pathname.startsWith(target));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | SaludSinBarreras</title>
    <!-- Inicialización instantánea de preferencias WCAG 2.2 para evitar parpadeo visual -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('ssb_a11y_prefs_v1');
          if (!raw) return;
          var p = JSON.parse(raw);
          var root = document.documentElement;
          var flag = function (v) { return v ? 'true' : 'false'; };
          if (p.fontScale) root.style.setProperty('--a11y-font-scale', String(p.fontScale));
          // Mismos atributos que a11yRootAttributes() en src/lib/accessibility.ts
          root.setAttribute('data-contrast', p.contrast === 'high' ? 'high' : 'standard');
          root.setAttribute('data-focus', p.focusEnhanced ? 'enhanced' : 'standard');
          root.setAttribute('data-line-height', p.lineHeight || 'normal');
          root.setAttribute('data-text-spacing', flag(p.textSpacing));
          root.setAttribute('data-readable-font', flag(p.readableFont));
          root.setAttribute('data-large-targets', flag(p.largeTargets));
          root.setAttribute('data-reduce-motion', flag(p.reduceMotion));
          root.setAttribute('data-easy-read', flag(p.easyRead));
          root.setAttribute('data-show-transcript', flag(p.showTranscript));
          root.setAttribute('data-pin-interpreter', flag(p.pinInterpreter));
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
    <!-- Regiones vivas para mensajes de estado (F4 · WCAG 4.1.3) -->
    <div id="ssb-announcer" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <div id="ssb-announcer-assertive" class="sr-only" role="alert" aria-live="assertive" aria-atomic="true"></div>

    <header class="site-header">
      <AccessibilityMenu />

      <div class="container">
        <div class="brand-bar">
          <a href="/" class="brand-logo">
            <span class="brand-badge" aria-hidden="true">SB</span>
            <span>
              <span class="brand-title">SaludSinBarreras</span>
              <span class="brand-subtitle">Telemedicina Inclusiva · WCAG 2.2 · IA No Conversacional</span>
            </span>
          </a>

          <div class="flex-wrap">
            <span class="badge badge-success">Prototipo Evaluación 19/11/2026</span>
          </div>
        </div>

        <nav class="main-nav" aria-label="Navegación principal">
          <a
            href="/"
            class="nav-link"
            aria-current={isCurrent('/') ? 'page' : undefined}
          >
            🏠 Inicio
          </a>
          <a
            href="/registro-paciente"
            class="nav-link"
            aria-current={isCurrent('/registro-paciente') ? 'page' : undefined}
          >
            📝 Registro Discapacidad (RF-01)
          </a>
          <a
            href="/usuarios-registrados"
            class="nav-link"
            aria-current={isCurrent('/usuarios-registrados') ? 'page' : undefined}
          >
            👥 Usuarios Registrados y Apoyos (RF-10)
          </a>
          <a
            href="/ia-harness"
            class="nav-link"
            aria-current={isCurrent('/ia-harness') ? 'page' : undefined}
          >
            ⚙️ Harness IA No Conversacional (RF-14)
          </a>
        </nav>
      </div>
    </header>

    <main id="contenido-principal" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container flex-wrap" style="justify-content: space-between;">
        <div>
          <strong>SaludSinBarreras — Grupo 5 (ULEAM · Usabilidad y Accesibilidad 6A)</strong><br />
          Integrantes: Elkin Delgado (Líder/Dev) · Jork Lucas (Analista) · Jhonny Castillo (QA/Dev Apoyo)
        </div>
        <div>
          Componente IA estrictamente no conversacional: no diagnostica ni prescribe; requiere validación profesional (RF-14).
        </div>
      </div>
    </footer>
    <SessionTimeout />
  </body>
</html>
