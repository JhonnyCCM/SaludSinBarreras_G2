---
// Menú de accesibilidad (F3): 15 opciones que el usuario activa, agrupadas por categoría.
// El criterio WCAG 2.2 va al final de cada opción, igual que en el documento F3.
import { SHORTCUT_DEFS, shortcutLabel } from '../lib/shortcuts';

const toggles = {
  visual: [
    { key: 'textSpacing', title: 'Espaciado de texto', desc: 'Más espacio entre letras, palabras y párrafos.', wcag: '1.4.12 AA' },
    { key: 'readableFont', title: 'Fuente legible', desc: 'Fuente sin serifa, texto a la izquierda y líneas de 80 caracteres.', wcag: '1.4.8 AAA' },
    { key: 'ttsFocusAuto', title: 'Leer el campo al enfocarlo', desc: 'Lee en voz alta la etiqueta de cada campo al moverte con Tab. Desactívalo si ya usas un lector de pantalla externo (NVDA, VoiceOver o TalkBack).', wcag: '1.1.1 A' },
  ],
  auditiva: [
    { key: 'subtitlesDefault', title: 'Subtítulos en vivo', desc: 'Subtítulos activos en la videoconsulta.', wcag: '1.2.4 AA' },
    { key: 'showTranscript', title: 'Transcripción', desc: 'Panel con el texto completo de la consulta.', wcag: '1.2.8 AAA' },
    { key: 'pinInterpreter', title: 'Ventana del intérprete fija y grande', desc: 'El video del intérprete de señas queda fijo y ampliado.', wcag: '1.2.6 AAA' },
    { key: 'visualAlerts', title: 'Alertas visuales y vibración', desc: 'Llamadas y recordatorios con destello, texto y vibración.', wcag: '1.3.3 A' },
  ],
  motriz: [
    { key: 'shortcutsEnabled', title: 'Atajos de teclado Alt+Shift', desc: 'Desactívalos si interfieren con tu tecnología de asistencia.', wcag: '2.1.1 A · 2.1.4 A' },
    { key: 'focusEnhanced', title: 'Foco reforzado', desc: 'Borde grueso y halo alrededor del control activo.', wcag: '2.4.7 AA · 2.4.11 AA · 2.4.13 AAA' },
    { key: 'largeTargets', title: 'Botones grandes', desc: 'Botones, enlaces y casillas de 44 × 44 px o más.', wcag: '2.5.5 AAA' },
  ],
  cognitiva: [
    { key: 'reduceMotion', title: 'Detener animaciones', desc: 'Pausa animaciones, transiciones y destellos.', wcag: '2.2.2 A · 2.3.3 AAA' },
    { key: 'easyRead', title: 'Lectura fácil', desc: 'Indicaciones en frases cortas, listas y pictogramas.', wcag: '3.1.5 AAA' },
  ],
} as const;
---

<section class="a11y-wrapper" aria-label="Accesibilidad">
  <!-- Aviso visual de alertas (F3 · 1.3.3); se anuncia también al lector de pantalla -->
  <div id="ssb-visual-alert-banner" class="a11y-live-banner" role="status" aria-live="polite" hidden>
    <span aria-hidden="true">🔔</span>
    <span id="ssb-visual-alert-text"></span>
    <button type="button" class="btn btn-secondary" id="ssb-close-alert-btn" aria-label="Cerrar aviso">Cerrar</button>
  </div>

  <!-- Burbuja flotante en esquina inferior derecha -->
  <button
    type="button"
    class="btn btn-primary a11y-fab"
    id="a11y-toggle-btn"
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="Abrir menú de accesibilidad (Alt+Shift+A)"
  >
    <span class="a11y-fab-icon" aria-hidden="true">♿</span>
    <span class="a11y-fab-label">Accesibilidad</span>
  </button>

  <div id="a11y-panel" class="a11y-panel" role="region" aria-labelledby="a11y-panel-title" hidden>
    <div class="a11y-panel-inner">
      <div class="a11y-panel-header">
        <div>
          <h2 class="a11y-panel-title" id="a11y-panel-title">Menú de accesibilidad</h2>
          <p class="a11y-quick-info" id="a11y-summary-pill" aria-live="polite">
            Texto <strong id="a11y-pill-scale">100%</strong> · <strong id="a11y-pill-contrast">Contraste estándar</strong>
          </p>
          <p class="form-hint" style="margin: 0.2rem 0 0;">
            Se guarda en este dispositivo. <kbd>Esc</kbd> cierra.
          </p>
        </div>
        <div class="flex-wrap">
          <button type="button" class="btn btn-secondary" id="a11y-reset-btn">↺ Restablecer</button>
          <button type="button" class="btn btn-primary" id="a11y-close-btn">✕ Cerrar</button>
        </div>
      </div>

      <div class="a11y-quick-actions mb-2">
        <button type="button" class="btn btn-secondary a11y-compact-btn" id="a11y-quick-tts">
          🔊 Leer <span class="kbd-hint" data-shortcut-hint="read"></span>
        </button>
        <button type="button" class="btn btn-secondary a11y-compact-btn" id="a11y-quick-stop-tts">⏹ Detener voz</button>
        <button type="button" class="btn btn-secondary a11y-compact-btn" id="a11y-open-shortcuts">
          ⌨️ Atajos <span class="kbd-hint" data-shortcut-hint="help"></span>
        </button>
      </div>

      <div class="a11y-grid">
        <fieldset class="a11y-fieldset">
          <legend>👁️ Visual</legend>

          <div class="a11y-control-block" role="group" aria-labelledby="lbl-font">
            <span class="form-label" id="lbl-font">Tamaño de texto <span class="wcag-tag">WCAG 1.4.4 AA</span></span>
            <div class="flex-wrap mt-1">
              <button type="button" class="btn btn-secondary" data-font-step="-0.25" aria-label="Reducir texto">A−</button>
              <button type="button" class="btn btn-secondary" data-font-set="1">100%</button>
              <button type="button" class="btn btn-secondary" data-font-set="1.5">150%</button>
              <button type="button" class="btn btn-secondary" data-font-set="2">200%</button>
              <button type="button" class="btn btn-secondary" data-font-step="0.25" aria-label="Aumentar texto">A+</button>
            </div>
          </div>

          <div class="a11y-control-block mt-2" role="group" aria-labelledby="lbl-contrast">
            <span class="form-label" id="lbl-contrast">Modo de contraste <span class="wcag-tag">WCAG 1.4.6 AAA</span></span>
            <div class="flex-wrap mt-1">
              <button type="button" class="btn btn-secondary" data-contrast-mode="standard">Estándar</button>
              <button type="button" class="btn btn-secondary" data-contrast-mode="high">Alto contraste (7:1)</button>
            </div>
          </div>

          <div class="a11y-control-block mt-2" role="radiogroup" aria-labelledby="lbl-line">
            <span class="form-label" id="lbl-line">Interlineado <span class="wcag-tag">WCAG 1.4.12 AA</span></span>
            <div class="flex-wrap mt-1">
              <label class="radio-chip"><input type="radio" name="a11y-line-height" value="normal" /> Normal</label>
              <label class="radio-chip"><input type="radio" name="a11y-line-height" value="medium" /> 1,5</label>
              <label class="radio-chip"><input type="radio" name="a11y-line-height" value="large" /> 2</label>
            </div>
          </div>

          {toggles.visual.map((t) => (
            <label class="check-card mt-1">
              <input type="checkbox" data-a11y-toggle={t.key} />
              <span class="check-card-body">
                <strong>{t.title} <span class="wcag-tag">WCAG {t.wcag}</span></strong>
                <span class="form-hint">{t.desc}</span>
              </span>
            </label>
          ))}
          <div class="flex-wrap mt-1">
            <button type="button" class="btn btn-accent" id="a11y-panel-tts-read">🔊 Leer en voz alta</button>
            <button type="button" class="btn btn-secondary" id="a11y-panel-tts-stop">⏹ Detener lectura</button>
          </div>
        </fieldset>

        <fieldset class="a11y-fieldset">
          <legend>👂 Auditiva</legend>
          {toggles.auditiva.map((t) => (
            <label class="check-card mt-1">
              <input type="checkbox" data-a11y-toggle={t.key} />
              <span class="check-card-body">
                <strong>{t.title} <span class="wcag-tag">WCAG {t.wcag}</span></strong>
                <span class="form-hint">{t.desc}</span>
              </span>
            </label>
          ))}
          <button type="button" class="btn btn-secondary mt-1" id="a11y-test-visual-alert">🔔 Probar alerta visual</button>
        </fieldset>

        <fieldset class="a11y-fieldset">
          <legend>✋ Motriz</legend>
          {toggles.motriz.map((t) => (
            <label class="check-card mt-1">
              <input type="checkbox" data-a11y-toggle={t.key} />
              <span class="check-card-body">
                <strong>{t.title} <span class="wcag-tag">WCAG {t.wcag}</span></strong>
                <span class="form-hint">{t.desc}</span>
              </span>
            </label>
          ))}

          <details class="mt-2" id="a11y-shortcut-editor">
            <summary class="touch-target summary-btn">Cambiar teclas de los atajos</summary>
            <p class="form-hint">Escribe una letra o un número. Todos se usan con <kbd>Alt</kbd>+<kbd>Shift</kbd>.</p>
            <ul class="shortcut-edit-list">
              {SHORTCUT_DEFS.filter((d) => d.editable).map((d) => (
                <li>
                  <label for={`sc-${d.action}`}>{d.label}</label>
                  <span class="flex-wrap" style="gap: 0.35rem;">
                    <span aria-hidden="true">Alt+Shift+</span>
                    <input
                      class="form-control shortcut-input"
                      id={`sc-${d.action}`}
                      data-shortcut-input={d.action}
                      maxlength="1"
                      autocomplete="off"
                      aria-describedby={`sc-err-${d.action}`}
                    />
                  </span>
                  <span class="field-error" id={`sc-err-${d.action}`}></span>
                </li>
              ))}
            </ul>
            <button type="button" class="btn btn-secondary" id="a11y-reset-shortcuts">↺ Restablecer atajos</button>
          </details>
        </fieldset>

        <fieldset class="a11y-fieldset">
          <legend>🧠 Cognitiva</legend>
          {toggles.cognitiva.map((t) => (
            <label class="check-card mt-1">
              <input type="checkbox" data-a11y-toggle={t.key} />
              <span class="check-card-body">
                <strong>{t.title} <span class="wcag-tag">WCAG {t.wcag}</span></strong>
                <span class="form-hint">{t.desc}</span>
              </span>
            </label>
          ))}
        </fieldset>
      </div>
    </div>
  </div>

  <!-- Lista de atajos (Alt+Shift+K). <dialog> nativo: Esc lo cierra y el foco vuelve al botón (2.1.2) -->
  <dialog id="shortcuts-dialog" class="ssb-dialog" aria-labelledby="shortcuts-dialog-title">
    <h2 id="shortcuts-dialog-title">Atajos de teclado</h2>
    <p class="form-hint" id="shortcuts-dialog-status"></p>
    <table class="data-table">
      <caption class="sr-only">Atajos de teclado del menú de accesibilidad</caption>
      <thead><tr><th scope="col">Atajo</th><th scope="col">Acción</th><th scope="col">Dónde funciona</th></tr></thead>
      <tbody>
        {SHORTCUT_DEFS.map((d) => (
          <tr><td><kbd data-shortcut-cell={d.action}>{shortcutLabel(d.code)}</kbd></td><td>{d.label}</td><td>{d.scope}</td></tr>
        ))}
        <tr><td><kbd>Tab</kbd> / <kbd>Shift+Tab</kbd></td><td>Avanzar o retroceder entre controles</td><td>Todas las pantallas</td></tr>
        <tr><td><kbd>Enter</kbd> / <kbd>Espacio</kbd></td><td>Activar un botón, enlace o casilla</td><td>Todas las pantallas</td></tr>
        <tr><td><kbd>Flechas</kbd></td><td>Moverse en listas, calendarios y grupos de opciones</td><td>Todas las pantallas</td></tr>
        <tr><td><kbd>Esc</kbd></td><td>Cerrar el menú o una ventana y detener la lectura</td><td>Todas las pantallas</td></tr>
      </tbody>
    </table>
    <form method="dialog" class="mt-2"><button class="btn btn-primary" value="close">Cerrar</button></form>
  </dialog>
</section>

<style>
  .a11y-fab {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 1200;
    border-radius: 999px;
    padding: 0.7rem 1.1rem;
    min-height: 52px;
    min-width: 52px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.25);
    border: 2px solid var(--surface);
  }
  .a11y-fab-icon { font-size: 1.25rem; line-height: 1; }
  @media (max-width: 520px) {
    .a11y-fab { padding: 0.7rem; }
    .a11y-fab-label { display: none; }
  }

  .a11y-quick-info { margin: 0; font-size: 0.9rem; }
  .a11y-quick-actions { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .a11y-compact-btn { padding: 0.4rem 0.75rem; font-size: 0.9rem; }
  .kbd-hint { font-size: 0.75rem; font-weight: 600; opacity: 0.85; }
  .kbd-hint:empty { display: none; }

  .a11y-panel {
    position: fixed;
    right: 1rem;
    bottom: 5rem;
    z-index: 1200;
    width: min(460px, calc(100vw - 2rem));
    max-height: min(76vh, 680px);
    overflow-y: auto;
    background: var(--surface);
    border: 3px solid var(--primary);
    border-radius: 16px;
    padding: 1rem;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.25);
  }
  .a11y-panel[hidden], .a11y-live-banner[hidden] { display: none; }
  .a11y-panel-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .a11y-panel-title { font-size: 1.15rem; margin-bottom: 0.2rem; }
  .a11y-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }
  .a11y-fieldset {
    border: 2px solid var(--border-subtle);
    border-radius: var(--radius);
    padding: 0.85rem;
    background: var(--bg);
    margin: 0;
  }
  .a11y-fieldset legend { font-weight: 800; padding-inline: 0.45rem; }
  .shortcut-edit-list { list-style: none; padding: 0; margin: 0 0 0.75rem; display: grid; gap: 0.6rem; }
  .shortcut-edit-list li { display: grid; gap: 0.25rem; }
  .shortcut-input { width: 3.2rem; text-align: center; text-transform: uppercase; font-weight: 700; }
  .a11y-live-banner {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 1190;
    max-width: min(460px, calc(100vw - 6.5rem));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    border: 2px solid var(--warning-border);
    background: var(--warning-bg);
    color: var(--warning-text);
    font-weight: 700;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.2);
  }
  .btn[aria-pressed='true'] {
    background: var(--primary);
    color: var(--primary-text);
    border-color: var(--primary);
  }
</style>

<script>
  import {
    DEFAULT_A11Y_STATE,
    applyAccessibilityState,
    clampFontScale,
    loadAccessibilityState,
    speakLongText,
    speakText,
    stopSpeaking,
    triggerVisualAlert,
    type AccessibilityState,
    type ContrastMode,
    type LineHeightMode,
  } from '../lib/accessibility';
  import {
    ROOM_ACTIONS,
    codeToLabel,
    loadShortcutCodes,
    matchShortcut,
    resetShortcuts,
    shortcutLabel,
    updateShortcut,
    type ShortcutAction,
    type ShortcutCodes,
  } from '../lib/shortcuts';

  type BoolKey = {
    [K in keyof AccessibilityState]: AccessibilityState[K] extends boolean ? K : never;
  }[keyof AccessibilityState];

  const toggleBtn = document.getElementById('a11y-toggle-btn') as HTMLButtonElement;
  const closeBtn = document.getElementById('a11y-close-btn') as HTMLButtonElement;
  const panel = document.getElementById('a11y-panel') as HTMLElement;
  const dialog = document.getElementById('shortcuts-dialog') as HTMLDialogElement;
  const alertBanner = document.getElementById('ssb-visual-alert-banner') as HTMLElement;
  const alertText = document.getElementById('ssb-visual-alert-text') as HTMLElement;

  let state: AccessibilityState = applyAccessibilityState(loadAccessibilityState());
  let codes: ShortcutCodes = loadShortcutCodes();

  const set = (patch: Partial<AccessibilityState>) => {
    state = applyAccessibilityState({ ...state, ...patch });
  };

  function syncUI(s: AccessibilityState) {
    state = s;
    document.getElementById('a11y-pill-scale')!.textContent = `${Math.round(s.fontScale * 100)}%`;
    document.getElementById('a11y-pill-contrast')!.textContent =
      s.contrast === 'high' ? 'Alto contraste' : 'Contraste estándar';
    document.querySelectorAll<HTMLInputElement>('[data-a11y-toggle]').forEach((input) => {
      input.checked = Boolean(s[input.dataset.a11yToggle as BoolKey]);
    });
    document.querySelectorAll<HTMLInputElement>('input[name="a11y-line-height"]').forEach((r) => {
      r.checked = r.value === s.lineHeight;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-font-set]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(Math.abs(Number(btn.dataset.fontSet) - s.fontScale) < 0.01));
    });
    document.querySelectorAll<HTMLButtonElement>('[data-contrast-mode]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.contrastMode === s.contrast));
    });
    document.getElementById('shortcuts-dialog-status')!.textContent = s.shortcutsEnabled
      ? 'Los atajos están activos.'
      : 'Los atajos están desactivados. Actívalos en Menú de accesibilidad › Motriz.';
  }

  function syncShortcutLabels(c: ShortcutCodes) {
    codes = c;
    document.querySelectorAll<HTMLElement>('[data-shortcut-hint]').forEach((el) => {
      el.textContent = `(${shortcutLabel(c[el.dataset.shortcutHint as ShortcutAction])})`;
    });
    document.querySelectorAll<HTMLElement>('[data-shortcut-cell]').forEach((el) => {
      el.textContent = shortcutLabel(c[el.dataset.shortcutCell as ShortcutAction]);
    });
    document.querySelectorAll<HTMLInputElement>('[data-shortcut-input]').forEach((input) => {
      if (document.activeElement !== input) input.value = codeToLabel(c[input.dataset.shortcutInput as ShortcutAction]);
    });
  }

  function setPanelOpen(open: boolean) {
    panel.hidden = !open;
    toggleBtn.setAttribute('aria-expanded', String(open));
    (open ? closeBtn : toggleBtn).focus();
  }

  /** Lee la selección, el campo enfocado o, si no hay ninguno, el contenido principal. */
  function readAloud() {
    const selection = window.getSelection()?.toString().trim();
    const active = document.activeElement as HTMLElement | null;
    let text = selection || '';
    if (!text && active && active !== document.body && active.matches('input, select, textarea')) {
      const label = active.id ? document.querySelector(`label[for="${CSS.escape(active.id)}"]`)?.textContent : '';
      text = `${label || active.getAttribute('aria-label') || ''}. ${(active as HTMLInputElement).value || ''}`;
    }
    if (!text) text = document.getElementById('contenido-principal')?.innerText || '';
    if (!speakLongText(text)) triggerVisualAlert('Tu navegador no tiene síntesis de voz disponible.');
  }

  function resetAll() {
    stopSpeaking();
    state = applyAccessibilityState({ ...DEFAULT_A11Y_STATE });
    triggerVisualAlert('Ajustes de accesibilidad restablecidos.');
  }

  function runAction(action: ShortcutAction) {
    switch (action) {
      case 'menu': setPanelOpen(panel.hidden); break;
      case 'textUp': set({ fontScale: clampFontScale(state.fontScale + 0.25) }); break;
      case 'textDown': set({ fontScale: clampFontScale(state.fontScale - 0.25) }); break;
      case 'contrast': set({ contrast: state.contrast === 'high' ? 'standard' : 'high' }); break;
      case 'read': readAloud(); break;
      case 'reset': resetAll(); break;
      case 'help': if (dialog.open) { dialog.close(); } else { dialog.showModal(); } break;
      default:
        if (!ROOM_ACTIONS.includes(action)) return;
        if (document.querySelector('[data-video-room]')) {
          window.dispatchEvent(new CustomEvent('ssb:shortcut', { detail: { action } }));
        } else {
          triggerVisualAlert('Este atajo funciona dentro de la videoconsulta.');
        }
    }
  }

  // ---------- Eventos ----------
  syncUI(state);
  syncShortcutLabels(codes);
  window.addEventListener('ssb:a11y-changed', (e) => syncUI((e as CustomEvent<AccessibilityState>).detail));
  window.addEventListener('ssb:shortcuts-changed', (e) => syncShortcutLabels((e as CustomEvent<ShortcutCodes>).detail));
  window.addEventListener('ssb:visual-alert', (e) => {
    alertText.textContent = (e as CustomEvent<{ message: string }>).detail.message;
    alertBanner.hidden = false;
  });

  document.getElementById('ssb-close-alert-btn')?.addEventListener('click', () => (alertBanner.hidden = true));
  toggleBtn.addEventListener('click', () => setPanelOpen(panel.hidden));
  closeBtn.addEventListener('click', () => setPanelOpen(false));
  document.getElementById('a11y-reset-btn')?.addEventListener('click', resetAll);
  document.getElementById('a11y-open-shortcuts')?.addEventListener('click', () => dialog.showModal());

  document.querySelectorAll<HTMLButtonElement>('[data-font-set]').forEach((btn) =>
    btn.addEventListener('click', () => set({ fontScale: Number(btn.dataset.fontSet) }))
  );
  document.querySelectorAll<HTMLButtonElement>('[data-font-step]').forEach((btn) =>
    btn.addEventListener('click', () => set({ fontScale: clampFontScale(state.fontScale + Number(btn.dataset.fontStep)) }))
  );
  document.querySelectorAll<HTMLButtonElement>('[data-contrast-mode]').forEach((btn) =>
    btn.addEventListener('click', () => set({ contrast: btn.dataset.contrastMode as ContrastMode }))
  );
  document.querySelectorAll<HTMLInputElement>('input[name="a11y-line-height"]').forEach((r) =>
    r.addEventListener('change', () => set({ lineHeight: r.value as LineHeightMode }))
  );
  document.querySelectorAll<HTMLInputElement>('[data-a11y-toggle]').forEach((input) =>
    input.addEventListener('change', () => {
      set({ [input.dataset.a11yToggle as BoolKey]: input.checked } as Partial<AccessibilityState>);
      if (input.dataset.a11yToggle === 'ttsFocusAuto' && input.checked) speakText('Lectura al enfocar activada.');
    })
  );

  document.querySelectorAll<HTMLInputElement>('[data-shortcut-input]').forEach((input) => {
    input.addEventListener('change', () => {
      const action = input.dataset.shortcutInput as ShortcutAction;
      const err = document.getElementById(`sc-err-${action}`)!;
      const result = updateShortcut(action, input.value);
      input.setAttribute('aria-invalid', String(!result.ok));
      err.textContent = result.ok ? '' : result.reason;
      err.classList.toggle('visible', !result.ok);
      if (!result.ok) input.value = codeToLabel(codes[action]);
    });
  });
  document.getElementById('a11y-reset-shortcuts')?.addEventListener('click', () => {
    resetShortcuts();
    triggerVisualAlert('Atajos de teclado restablecidos.');
  });

  document.getElementById('a11y-quick-tts')?.addEventListener('click', readAloud);
  document.getElementById('a11y-panel-tts-read')?.addEventListener('click', readAloud);
  document.getElementById('a11y-quick-stop-tts')?.addEventListener('click', stopSpeaking);
  document.getElementById('a11y-panel-tts-stop')?.addEventListener('click', stopSpeaking);
  document.getElementById('a11y-test-visual-alert')?.addEventListener('click', () =>
    triggerVisualAlert('Alerta de prueba: así se avisan las llamadas y recordatorios sin depender del sonido.')
  );

  // Opción "Leer el campo al enfocarlo" con retardo de 180 ms para evitar cortes al tabular rápido
  let focusSpeakTimer = 0;
  document.addEventListener('focusin', (event) => {
    window.clearTimeout(focusSpeakTimer);
    if (!state.ttsFocusAuto) return;
    const target = event.target as HTMLElement | null;
    if (!target || target === document.body || target.id === 'contenido-principal') return;
    const id = target.getAttribute('id');
    const text =
      target.getAttribute('aria-label') ||
      (id ? document.querySelector(`label[for="${CSS.escape(id)}"]`)?.textContent : '') ||
      target.closest('label')?.textContent ||
      target.textContent ||
      '';
    const trimmed = text.trim();
    if (!trimmed) return;
    focusSpeakTimer = window.setTimeout(() => {
      speakText(trimmed.slice(0, 180));
    }, 180);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      window.clearTimeout(focusSpeakTimer);
      stopSpeaking();
      if (!panel.hidden) {
        event.preventDefault();
        setPanelOpen(false);
      }
      return;
    }
    if (!state.shortcutsEnabled) return;
    const action = matchShortcut(event, codes);
    if (action) {
      event.preventDefault();
      runAction(action);
    }
  });
</script>
