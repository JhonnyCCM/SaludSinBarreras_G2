# Configuración opcional del Harness de IA No Conversacional
# Si no se configura API_KEY, el sistema usa automáticamente el motor determinista local (local-deterministic-fallback).
# Proveedores soportados: rust-agente (por defecto) | local-deterministic-fallback | gemini | openai | ollama
PUBLIC_AI_PROVIDER=rust-agente
PUBLIC_AI_API_URL=
PUBLIC_AI_MODEL=
# En modo prototipo local/cliente solo configurar claves de prueba si usas proxy o endpoint local (ej. Ollama):
PUBLIC_AI_API_KEY=
# Si más adelante migran a SSR/Backend, usar variables privadas en el servidor:
AI_API_KEY=

# Agente IA no conversacional en Rust (backend/agente-ia). Si no responde, se usa el motor local.
PUBLIC_AGENTE_URL=http://127.0.0.1:8787
